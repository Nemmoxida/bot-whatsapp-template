{
  "name": "whatsapp-bot-baileys",
  "version": "0.1.9",
  "description": "This is a simple and powerful WhatsApp bot built using the [Baileys](https://github.com/WhiskeySockets/Baileys) library, an unofficial WhatsApp Web API for Node.js. It allows you to automate replies, handle user messages, and create intelligent bot logic.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "automation",
    "nodejs"
  ],
  "author": "nexoscreator",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "js-yaml": "^5.4.1",
    "libsignal": "git+https://github.com/whiskeysockets/libsignal-node.git",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.32.6",
    "wa-sticker-formatter": "^4.4.4"
  },
  "overrides": {
    "wa-sticker-formatter": {
      "sharp": "^0.33.5"
    }
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.1"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "sharp@0.32.6": true
  }
}
